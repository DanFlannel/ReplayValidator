# Local-dev Dockerfile for ReplayValidator Go services, adapted from the
# Denarius/Pugio pattern. Builds straight from source with no dependency on
# Artifact Registry, so `docker compose up --build` works on a fresh laptop.
#
# Usage:
#   docker build -f Dockerfile.local --build-arg SERVICE=api -t replayvalidator-api:local .

FROM golang:1.26 AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG SERVICE
RUN test -n "$SERVICE" || (echo "SERVICE build arg required" && exit 1)
ARG GO_BUILD_PARALLELISM=2
RUN CGO_ENABLED=0 GOOS=linux go build -p ${GO_BUILD_PARALLELISM} -ldflags="-s -w" -o /out/app ./services/${SERVICE}
RUN mkdir -p /out/static && if [ -d "services/${SERVICE}/static" ]; then cp -r "services/${SERVICE}/static/." /out/static/; fi

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/app /app/app
COPY --from=builder /out/static /app/static
ENTRYPOINT ["/app/app"]
